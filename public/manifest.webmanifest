{
  "id": "/",
  "name": "Sa2 Plus",
  "short_name": "Sa2 Plus",
  "description": "Sa2 Plus",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#1a1f24",
  "theme_color": "#1a1f24",
  "lang": "ja",
  "share_target": {
    "action": "/music/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "files": [
        {
          "name": "tracks",
          "accept": ["audio/*", ".mp3", ".m4a", ".aac", ".wav", ".ogg", ".webm"]
        }
      ]
    }
  },
  "icons": [
    {
      "src": "/icons/pwa-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/pwa-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/pwa-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
