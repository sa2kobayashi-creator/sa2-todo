APP_NAME="Sa2 Plus"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_VERSION=1.0.0

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# パスワード再設定（6桁コード）
PASSWORD_RESET_CODE_TTL_MINUTES=15
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_RESEND_INTERVAL_SECONDS=60

# メールアドレス変更（6桁コード）
EMAIL_CHANGE_CODE_TTL_MINUTES=30
EMAIL_CHANGE_MAX_ATTEMPTS=5
EMAIL_CHANGE_RESEND_INTERVAL_SECONDS=60

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# LiveKit Cloud / self-hosted LiveKit（DM通話）
# 通常は 設定 → 外部連携 → LiveKit 通話 から登録する。未設定時のみここがフォールバック。
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Web Push / Android TWA 通知委任
# 通常は 設定 → 外部連携 → Web Push 着信通知 から登録する。未設定時のみここがフォールバック。
WEB_PUSH_VAPID_SUBJECT=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=

# 新規登録の招待コード（フォールバック）。通常は管理画面「ユーザー管理」で設定する。
# DB 未設定のときだけここが使われる。空＝自己登録閉鎖。
REGISTRATION_INVITE_CODE=

# Google Maps（Transit / Map）。通常は設定 → API設定 で保存する。DB 未設定のときだけここが使われる。
# 本番では Cloud コンソールで HTTP リファラ制限（https://your-domain/*）と予算アラートを必ず設定する。
GOOGLE_MAPS_API_KEY=

# 経路検索に使う API。auto / google / navitime / raptor。設定 → API設定 の選択が優先される。
ROUTE_PROVIDER=auto

# Google Maps Routes API（路線検索の経路探索）。通常は設定 → API設定 で保存する。空のときは GOOGLE_MAPS_API_KEY を流用できる。
GOOGLE_ROUTES_API_KEY=

# YouTube Data API v3（動画ページのキーワード検索・人気動画）。通常は設定 → AI で保存する。
# URL 貼り付け再生（YouTube / TikTok）には不要。
YOUTUBE_DATA_API_KEY=

# NAVITIME API（路線検索の経路探索）。通常は設定 → API設定 で保存する。DB 未設定のときだけここが使われる。
# mode=rapidapi のときは RapidAPI のキーとホスト、mode=direct のときは契約時に配られたベース URL を使う。
NAVITIME_MODE=rapidapi
NAVITIME_API_KEY=
NAVITIME_ROUTE_HOST=navitime-route-totalnavi.p.rapidapi.com
# 地点名 → 緯度経度の解決に NAVITIME Transport を使う場合のみ（未設定なら Google Maps で解決）
NAVITIME_NODE_HOST=
# 直接契約のとき: https://{HOST}/{CID}/v1
NAVITIME_BASE_URL=
NAVITIME_AUTH_HEADER=x-api-key

# Google Calendar OAuth（ログインではない。カレンダー連携専用）。
# 通常は設定 → API設定 で保存する。DB 未設定のときだけここが使われる。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/calendar/callback"

# LINE / Facebook Messenger は設定 → 外部連携 UI で保存（DB暗号化）。以下は任意のフォールバック。
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_CHANNEL_SECRET=
# LINE_BOT_BASIC_ID=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# FACEBOOK_PAGE_ACCESS_TOKEN=
# FACEBOOK_VERIFY_TOKEN=
# FACEBOOK_PAGE_NAME=

# Photos
PHOTO_DISK=public
# ユーザーごとの製品無料枠（既定 Light 20GB = 21474836480）。Standard は PHOTO_STANDARD_QUOTA_BYTES
# 本番で旧 50GB(53687091200) が残っていたら必ず 21474836480 に更新し、php artisan config:clear
PHOTO_USER_FREE_QUOTA_BYTES=21474836480
# Standard / スタッフの製品無料枠（既定 200GB）
PHOTO_STANDARD_QUOTA_BYTES=214748364800
# 利用申請（ライト週次上限・目的最小文字・休眠削除）
# REGISTRATION_LIGHT_WEEKLY_CAP=50
# REGISTRATION_PURPOSE_MIN_LENGTH=20
# REGISTRATION_LIGHT_INACTIVE_WARN_DAYS=90
# REGISTRATION_LIGHT_INACTIVE_DELETE_GRACE_DAYS=14
# REGISTRATION_APPLICATION_TOKEN_TTL_DAYS=7
# 本番 cron（毎分）: php artisan schedule:run
# → users:prune-dormant-light は毎日 04:15。揃え確認: php artisan registration:align-light-trial
# 保存容量バーの表示上限（既定 1TiB）。無料枠とは別
PHOTO_STORAGE_DISPLAY_CAPACITY_BYTES=1099511627776
# ホット（R2）ソフト上限（長期保存へ移す目安・既定 10GB）
PHOTO_USER_QUOTA_BYTES=10737418240
# 無料枠超過時: 見込表示のみ。true にすると有料超過アップロードを許可（将来 Stripe 等）
PHOTO_PAID_OVERAGE_ENABLED=false
# 無料枠超過かつ有料未契約なら新規追加を拒否（既定 true）
PHOTO_BLOCK_UPLOADS_OVER_FREE_QUOTA=true
# 超過時の目安単価（USD / GB / 月）
PHOTO_OVERAGE_PRICE_PER_GB_MONTH_USD=0.015
PHOTO_MAX_UPLOAD_BYTES=0
PHOTO_MAX_VIDEO_UPLOAD_BYTES=1073741824
PHOTO_MAX_LONG_EDGE=0
PHOTO_THUMB_LONG_EDGE=720
PHOTO_JPEG_QUALITY=82
# 動画再生: R2/B2 署名URLへ直リンク（既定 true。遅さが残る場合は本番で true を確認）
PHOTO_VIDEO_SIGNED_REDIRECT=true
# PHOTO_VIDEO_SIGNED_TTL_MINUTES=60
# B2へアーカイブ（Photos手動）: 件数 / ソフト期限秒 / 大ファイル閾値 / クライアント待機秒 / 最大バッチ
# PHOTO_ARCHIVE_COLD_BATCH_SIZE=8
# PHOTO_ARCHIVE_COLD_BATCH_SECONDS=45
# PHOTO_ARCHIVE_COLD_LARGE_FILE_BYTES=83886080
# PHOTO_ARCHIVE_COLD_TIMEOUT_SECONDS=180
# PHOTO_ARCHIVE_COLD_MAX_BATCHES=200
# ストレージ監視（メール/DB/R2 → B2）。値はバイト。未設定なら仕様書の初期値
# STORAGE_R2_WARN_BYTES=8589934592
# STORAGE_R2_ARCHIVE_BYTES=9663676416
# STORAGE_MAIL_WARN_BYTES=734003200
# STORAGE_MAIL_ARCHIVE_BYTES=838860800
# STORAGE_DB_WARN_BYTES=314572800
# STORAGE_DB_ARCHIVE_BYTES=524288000
# STORAGE_DB_BACKUP_KEEP_DAYS=14
# STORAGE_DB_BACKUP_DRIVER=mysqldump
# STORAGE_MYSQLDUMP_PATH=mysqldump
# STORAGE_DB_BACKUP_TIMEOUT=900
# 動画トリム用（PATH 上の ffmpeg、または絶対パス）。未設定時は "ffmpeg"
FFMPEG_PATH=ffmpeg

# 動画アップロードには PHP 側も必要です（upload_max_filesize / post_max_size を 900M 以上）
# ローカル: composer serve  または  php -c php-upload.ini artisan serve
# ロリポップ: public/.user.ini を参照

# 本番用テンプレート: .env.production.example
# 公開フォルダは必ず Laravel の public/ を指定（例: sa2todo/public）

# Cloudflare R2（PHOTO_DISK=r2 のとき使用。設定メニューからも上書き可）
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_URL=
R2_REGION=auto
R2_USE_PATH_STYLE_ENDPOINT=true

# Cloudinary（画面表示用。推奨は設定メニューから入力）
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=sa2todo

# ユーザー別・日次の利用上限（翻訳文字数 / LLM音声回数 / 生活ガイド）
USER_TRANSLATE_CHARS_PER_DAY=50000
USER_LLM_VOICE_REQUESTS_PER_DAY=30
USER_WORKERS_AI_REQUESTS_PER_DAY=20

# テナント契約の公開料金（税込）
COMMERCIAL_TENANT_MONTHLY_YEN=3980
COMMERCIAL_TENANT_TRIAL_DAYS=30

# Stripe。未保存時のフォールバック。通常は設定 → 公開販売 から入れる
BILLING_ENABLED=false
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=jpy
CASHIER_CURRENCY_LOCALE=ja_JP
BILLING_PRICE_STANDARD_MONTHLY=
BILLING_PRICE_STANDARD_YEARLY=
BILLING_PRICE_TENANT_MONTHLY=
BILLING_PRICE_TENANT_YEARLY=
BILLING_PRICE_MAILBOX_MONTHLY=
BILLING_PRICE_STORAGE_OVERAGE=
BILLING_PAST_DUE_GRACE_DAYS=7

# 個人向け Standard とストレージ超過。TOP・特商法表記が同じ値を参照する
COMMERCIAL_STANDARD_MONTHLY_YEN=980
COMMERCIAL_STANDARD_YEARLY_YEN=9800
COMMERCIAL_STANDARD_TRIAL_DAYS=14
COMMERCIAL_STORAGE_OVERAGE_YEN=300
COMMERCIAL_PRICES_INCLUDE_TAX=true

# 特定商取引法の事業者情報。未保存時のフォールバック。通常は設定 → 公開販売 から入れる
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_TRADE_NAME=
LEGAL_OPERATOR_MANAGER=
LEGAL_ADDRESS=
LEGAL_PHONE=
LEGAL_PHONE_HOURS=
LEGAL_CONTACT_EMAIL=
LEGAL_PRIVACY_CONTACT_EMAIL=
LEGAL_INVOICE_NUMBER=

# 前段プロキシ。既定は '*'（全許可）。本番では実 IP に絞ると IP 偽装を防げる
# TRUSTED_PROXIES=

# Cloudflare Workers AI（生活ガイド。推奨は設定メニューから入力）
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WORKERS_AI_TOKEN=
CLOUDFLARE_WORKERS_AI_MODEL="@cf/meta/llama-3.1-8b-instruct-fp8"

# Backblaze B2（長期保存。推奨は設定メニューから入力）
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
B2_ENDPOINT=
B2_URL=
B2_REGION=us-west-004
B2_USE_PATH_STYLE_ENDPOINT=true
