APP_NAME="Sa2 Plus"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://sa2-plus.com

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ja_JP

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# 単一ファイルだと共有サーバのディスクを食い続けるので日次ローテーションにする
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# 前段のプロキシ。'*' のままだと X-Forwarded-For を詐称してレート制限を回避できる。
# ロリポップ直なら空、CDN を挟むならその IP レンジをカンマ区切りで列挙する。
TRUSTED_PROXIES=

# ロリポップのデータベース（ユーザー専用ページ → データベース）
DB_CONNECTION=mysql
DB_HOST=mysqlXXX.phy.lolipop.lan
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@sa2-plus.com"
MAIL_FROM_NAME="${APP_NAME}"

# Web Push / Android TWA 着信通知
# 通常は 設定 → 外部連携 → Web Push 着信通知 から登録（DB暗号化）。以下は任意のフォールバック。
WEB_PUSH_VAPID_SUBJECT=mailto:admin@sa2-plus.com
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=

# パスワード再設定（6桁コード）
PASSWORD_RESET_CODE_TTL_MINUTES=15
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_RESEND_INTERVAL_SECONDS=60

# メールアドレス変更（6桁コード）
EMAIL_CHANGE_CODE_TTL_MINUTES=30
EMAIL_CHANGE_MAX_ATTEMPTS=5
EMAIL_CHANGE_RESEND_INTERVAL_SECONDS=60

# Photos（本番は R2 推奨。設定画面のストレージ設定でも上書き可）
PHOTO_DISK=r2
PHOTO_USER_FREE_QUOTA_BYTES=53687091200
PHOTO_STANDARD_QUOTA_BYTES=214748364800
PHOTO_STORAGE_DISPLAY_CAPACITY_BYTES=1099511627776
PHOTO_USER_QUOTA_BYTES=10737418240
PHOTO_PAID_OVERAGE_ENABLED=false
PHOTO_BLOCK_UPLOADS_OVER_FREE_QUOTA=true
PHOTO_OVERAGE_PRICE_PER_GB_MONTH_USD=0.015
PHOTO_MAX_UPLOAD_BYTES=0
PHOTO_MAX_VIDEO_UPLOAD_BYTES=1073741824
PHOTO_THUMB_LONG_EDGE=720
PHOTO_JPEG_QUALITY=82
# 動画は R2/B2 署名URL直リンク（ロリポップ経由より大幅に速い）
PHOTO_VIDEO_SIGNED_REDIRECT=true
PHOTO_VIDEO_SIGNED_TTL_MINUTES=60

# ロリポップ共有サーバでは ffmpeg は原則不可
# FFMPEG_PATH=

# Cloudflare R2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_URL=
R2_REGION=auto
R2_USE_PATH_STYLE_ENDPOINT=true

# Cloudinary（任意）
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=sa2todo

# Backblaze B2（任意・長期保存）
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
B2_ENDPOINT=
B2_URL=
B2_REGION=us-west-004
B2_USE_PATH_STYLE_ENDPOINT=true

# 新規登録の招待コード（フォールバック）。通常は管理画面「ユーザー管理」で設定する。
REGISTRATION_INVITE_CODE=

# Google Maps。通常は設定 → API設定 で保存する。DB 未設定のときだけここが使われる。
# Cloud コンソールで HTTP リファラ制限（https://sa2-plus.com/* 等）と予算アラートを必ず設定する。
GOOGLE_MAPS_API_KEY=

# YouTube Data API v3（動画のキーワード検索）。通常は設定 → AI で保存。URL再生には不要。
YOUTUBE_DATA_API_KEY=

# Google Calendar OAuth（ログインではない）。通常は設定 → API設定 で保存する。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/calendar/callback"

# 特定商取引法・Stripe は設定 → 公開販売 が正。ここは未保存時のフォールバック。
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_TRADE_NAME=
LEGAL_OPERATOR_MANAGER=
LEGAL_ADDRESS=
LEGAL_PHONE=
LEGAL_PHONE_HOURS=
LEGAL_CONTACT_EMAIL=
LEGAL_PRIVACY_CONTACT_EMAIL=
# 課税事業者になったら適格請求書発行事業者の登録番号を設定する
LEGAL_INVOICE_NUMBER=

# Stripe。BILLING_ENABLED=true にするまで申し込みボタンは出ない。
# price ID は Stripe ダッシュボードで作った本番用の値（テスト用と混ぜない）。
BILLING_ENABLED=false
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=jpy
CASHIER_CURRENCY_LOCALE=ja_JP
BILLING_PRICE_STANDARD_MONTHLY=
BILLING_PRICE_STANDARD_YEARLY=
BILLING_PRICE_TENANT_MONTHLY=
BILLING_PRICE_TENANT_YEARLY=
BILLING_PRICE_MAILBOX_MONTHLY=
BILLING_PRICE_STORAGE_OVERAGE=
BILLING_PAST_DUE_GRACE_DAYS=7

# 公開価格。TOP・特商法表記・Stripe はすべてこの値を参照する
COMMERCIAL_STANDARD_MONTHLY_YEN=980
COMMERCIAL_STANDARD_YEARLY_YEN=9800
COMMERCIAL_STANDARD_TRIAL_DAYS=14
COMMERCIAL_STORAGE_OVERAGE_YEN=300
# 表示価格は税込（総額表示）。上の金額は税込額として扱う
COMMERCIAL_PRICES_INCLUDE_TAX=true
