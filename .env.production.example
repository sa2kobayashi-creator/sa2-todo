APP_NAME="Sa2 Studio"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://sa2-plus.com

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ja_JP

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ロリポップのデータベース（ユーザー専用ページ → データベース）
DB_CONNECTION=mysql
DB_HOST=mysqlXXX.phy.lolipop.lan
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@sa2-plus.com"
MAIL_FROM_NAME="${APP_NAME}"

# Photos（本番は R2 推奨。設定画面のストレージ設定でも上書き可）
PHOTO_DISK=r2
PHOTO_USER_FREE_QUOTA_BYTES=21474836480
PHOTO_STORAGE_DISPLAY_CAPACITY_BYTES=1099511627776
PHOTO_USER_QUOTA_BYTES=10737418240
PHOTO_PAID_OVERAGE_ENABLED=false
PHOTO_BLOCK_UPLOADS_OVER_FREE_QUOTA=true
PHOTO_OVERAGE_PRICE_PER_GB_MONTH_USD=0.015
PHOTO_MAX_UPLOAD_BYTES=0
PHOTO_MAX_VIDEO_UPLOAD_BYTES=838860800
PHOTO_THUMB_LONG_EDGE=720
PHOTO_JPEG_QUALITY=82

# ロリポップ共有サーバでは ffmpeg / Real-ESRGAN / SwinIR(GPU) は原則不可
# 鮮明化は Stability AI、または別GPU VPS の SwinIR エンドポイントを推奨
# FFMPEG_PATH=
# REALESRGAN_BINARY=
# SWINIR_TIMEOUT=600

# Cloudflare R2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_URL=
R2_REGION=auto
R2_USE_PATH_STYLE_ENDPOINT=true

# Cloudinary（任意）
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=sa2todo

# Backblaze B2（任意・長期保存）
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
B2_ENDPOINT=
B2_URL=
B2_REGION=us-west-004
B2_USE_PATH_STYLE_ENDPOINT=true

GOOGLE_MAPS_API_KEY=
